# Safe local default: keeps external writes, payment calls, email, and CMS reads disabled.
DEMO_MODE=true

# Explicit launch gate. Keep false until MongoDB, live payments, webhooks, and the public HTTPS URL are verified.
DONATIONS_ENABLED=false

# Public contact/newsletter/volunteer launch gate. Keep false until the verified sender,
# monitored notification mailbox, privacy review, and operational response workflow are ready.
PUBLIC_SUBMISSIONS_ENABLED=false

# Separate email-list launch gate. Keep false until consent confirmation,
# suppression, sending ownership, and unsubscribe operations are approved.
NEWSLETTER_ENABLED=false

# Public application URL used for metadata, canonical URLs, and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publish bundled editorial pages only after organisational review and approval.
NEXT_PUBLIC_CONTENT_VERIFIED=false
# Must match the immutable release ID approved in src/lib/content-config.ts.
# The bundled demonstration content has no approved production release ID.
NEXT_PUBLIC_CONTENT_RELEASE_ID=

# Optional verified public mailbox. When blank, visitors use the durable contact form.
NEXT_PUBLIC_CONTACT_EMAIL=

# MongoDB persistence. Leave blank in demo mode.
MONGODB_URI=
MONGODB_DB_NAME=skymeredian-foundation

# Clerk. Both keys activate authentication middleware for dashboard/admin routes.
# With either key missing protected routes fail closed outside explicit local demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs allowed to access /admin. Empty denies everyone.
ADMIN_USER_IDS=

# Stripe server-side Checkout and signed webhook verification. Production requires live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay order creation, checkout hand-off, and signed webhook verification. Production requires rzp_live_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Sanity read API. Vercel Marketplace aliases and legacy names are supported;
# NEXT_PUBLIC variants intentionally contain identifiers, never credentials.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_STUDIO_API_PROJECT_ID=
SANITY_STUDIO_API_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Preferred server-only read credential provisioned by the Sanity integration.
SANITY_API_READ_TOKEN=
# Legacy fallback only; if used, this must also be a least-privilege read token.
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=
# SANITY_API_WRITE_TOKEN is intentionally never consumed by the web runtime.

# Legacy Studio identifier fallbacks. A separate sanity/.env.local may be used
# because root .env.local loading is not assumed after changing directories.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional standalone Express adapter.
PORT=4000
