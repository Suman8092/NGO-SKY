# Safe local default: keeps external writes, payment calls, email, and CMS reads disabled.
DEMO_MODE=true

# Explicit launch gate. Keep false until MongoDB, live payments, webhooks, and the public HTTPS URL are verified.
DONATIONS_ENABLED=false

# Public contact/newsletter/volunteer launch gate. Keep false until the verified sender,
# monitored notification mailbox, privacy review, and operational response workflow are ready.
PUBLIC_SUBMISSIONS_ENABLED=false

# Public application URL used for metadata, canonical URLs, and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publish bundled editorial pages only after organisational review and approval.
NEXT_PUBLIC_CONTENT_VERIFIED=false

# Optional verified public mailbox. When blank, visitors use the durable contact form.
NEXT_PUBLIC_CONTACT_EMAIL=

# MongoDB persistence. Leave blank in demo mode.
MONGODB_URI=
MONGODB_DB_NAME=ashaaya-foundation

# Clerk. Both keys activate authentication middleware for dashboard/admin routes.
# With either key missing protected routes fail closed outside explicit local demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs allowed to access /admin. Empty denies everyone.
ADMIN_USER_IDS=

# Stripe server-side Checkout and signed webhook verification. Production requires live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay order creation, checkout hand-off, and signed webhook verification. Production requires rzp_live_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Sanity read API. Server-only names are preferred; NEXT_PUBLIC variants also
# support the Studio and intentionally contain identifiers, not secrets.
SANITY_PROJECT_ID=
SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# Make these identifiers available to the Studio process; a separate
# sanity/.env.local may be used because root .env.local loading is not assumed.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional standalone Express adapter.
PORT=4000
